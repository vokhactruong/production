generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  /// Uniqueness enforced via a partial unique index (email WHERE "deletedAt" IS NULL) —
  /// see migration 20260702010000_partial_unique_active_email — so a soft-deleted
  /// user's email can be reused. Not marked @unique: Prisma's schema DSL cannot express
  /// partial indexes, so all lookups must go through findFirst with deletedAt: null.
  email         String
  password      String?
  firstName     String
  lastName      String
  avatar        String?
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  articles          Article[]
  auditLogs         AuditLog[]
  employee          Employee?
  oauthAccounts     OAuthAccount[]
  refreshTokens     RefreshToken[]
  userRoles         UserRole[]
  markedAttendances Attendance[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  code            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  providerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@map("categories")
}

model Article {
  id                String        @id @default(cuid())
  title             String
  slug              String        @unique
  excerpt           String?
  content           String
  thumbnail         String?
  status            ArticleStatus @default(DRAFT)
  publishedAt       DateTime?
  viewCount         Int           @default(0)
  tags              String[]      @default([])
  authorId          String
  categoryId        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  thumbnailPublicId String?
  deletedAt         DateTime?
  author            User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category          Category?     @relation(fields: [categoryId], references: [id])

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
  @@index([deletedAt])
  @@map("articles")
}

model Student {
  id            String        @id @default(cuid())
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  gender        Gender?
  phone         String?
  email         String?
  avatar        String?
  address       String?
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  status        StudentStatus @default(ACTIVE)
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  code          String?       @unique
  enrollments   Enrollment[]

  @@index([status])
  @@index([deletedAt])
  @@index([email])
  @@map("students")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@map("audit_logs")
}

model PendingDeletion {
  id          String    @id @default(cuid())
  publicId    String
  entity      String
  entityId    String?
  error       String?
  retryCount  Int       @default(0)
  lastTriedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("pending_deletions")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

model Subject {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  color       String?
  icon        String?
  status      SubjectStatus @default(ACTIVE)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  courses     Course[]
  classes     Class[]

  @@index([status])
  @@index([deletedAt])
  @@map("subjects")
}

enum CourseType {
  NORMAL
  TRIAL
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeType {
  TEACHER
  RECEPTIONIST
  ACCOUNTANT
  ACADEMIC
  MANAGER
  DIRECTOR
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
}

model Employee {
  id           String         @id @default(cuid())
  code         String         @unique
  firstName    String
  lastName     String
  email        String?
  phone        String?
  gender       Gender?
  dateOfBirth  DateTime?
  address      String?
  avatar       String?
  employeeType EmployeeType
  hireDate     DateTime?
  status       EmployeeStatus @default(ACTIVE)
  notes        String?
  userId       String?        @unique
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User?          @relation(fields: [userId], references: [id])
  classes      Class[]

  @@index([status])
  @@index([employeeType])
  @@index([deletedAt])
  @@map("employees")
}

model Course {
  id             String       @id @default(cuid())
  subjectId      String
  code           String       @unique
  name           String
  description    String?
  courseType     CourseType   @default(NORMAL)
  packageLessons Int
  lessonDuration Int
  basePrice      Decimal
  displayOrder   Int          @default(0)
  status         CourseStatus @default(ACTIVE)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  subject        Subject      @relation(fields: [subjectId], references: [id])
  classes        Class[]

  @@index([subjectId])
  @@index([deletedAt])
  @@index([status])
  @@index([displayOrder])
  @@map("courses")
}

enum ClassroomType {
  PHYSICAL
  ONLINE
  LAB
}

model Classroom {
  id          String        @id @default(cuid())
  /// Uniqueness enforced via a partial unique index (code WHERE "deletedAt" IS NULL) —
  /// see migration 20260703010000_partial_unique_active_classroom_code — so a soft-deleted
  /// classroom's code can be reused. Not marked @unique: Prisma's schema DSL cannot express
  /// partial indexes, so all lookups must go through findFirst with deletedAt: null.
  code        String
  name        String
  type        ClassroomType
  capacity    Int
  description String?
  isActive    Boolean       @default(true)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  classes     Class[]

  @@index([type])
  @@index([isActive])
  @@index([deletedAt])
  @@map("classrooms")
}

enum ClassStatus {
  PLANNING
  OPEN
  FULL
  COMPLETED
  CANCELLED
}

model Class {
  id             String          @id @default(cuid())
  /// Uniqueness enforced via a partial unique index (code WHERE "deletedAt" IS NULL) —
  /// see migration 20260704000000_add_class — so a soft-deleted class's code can be
  /// reused. Not marked @unique: Prisma's schema DSL cannot express partial indexes,
  /// so all lookups must go through findFirst with deletedAt: null.
  code           String
  name           String
  courseId       String
  subjectId      String
  classroomId    String
  employeeId     String
  status         ClassStatus     @default(PLANNING)
  capacity       Int
  sessionCount   Int             @default(15)
  startDate      DateTime
  endDate        DateTime
  description    String?
  isActive       Boolean         @default(true)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  course         Course          @relation(fields: [courseId], references: [id])
  subject        Subject         @relation(fields: [subjectId], references: [id])
  classroom      Classroom       @relation(fields: [classroomId], references: [id])
  employee       Employee        @relation(fields: [employeeId], references: [id])
  enrollments    Enrollment[]
  classSessions  ClassSession[]
  classSchedules ClassSchedule[]

  @@index([courseId])
  @@index([subjectId])
  @@index([classroomId])
  @@index([employeeId])
  @@index([status])
  @@index([isActive])
  @@index([deletedAt])
  @@map("classes")
}

/// The Planning Layer of the Scheduling Engine: a Class's recurring weekly
/// slots (e.g. "every Monday 18:00-20:00"). This is the source of truth the
/// generation engine reads from to produce ClassSession rows (the Execution
/// Layer) — see SchedulingService. Editing a ClassSchedule never touches
/// already-generated ClassSession rows; it only affects future generate/sync
/// runs.
model ClassSchedule {
  id        String    @id @default(cuid())
  classId   String
  /// 0 = Sunday .. 6 = Saturday, matching JS Date#getUTCDay().
  weekday   Int
  /// Uniqueness of (classId, weekday, startTime) enforced via a partial unique
  /// index WHERE "deletedAt" IS NULL — see migration
  /// 20260708000000_add_class_schedule. Unlike ClassSession.sessionNumber,
  /// this is not a permanent business identifier — it's just the current set
  /// of active weekly slots, so a soft-deleted slot's (weekday, startTime) can
  /// be freely reused by a new slot. Not marked @@unique: Prisma's schema DSL
  /// cannot express partial indexes, so all lookups must go through
  /// findFirst/findMany with deletedAt: null.
  startTime DateTime  @db.Time
  endTime   DateTime  @db.Time
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  class     Class     @relation(fields: [classId], references: [id])

  @@index([classId])
  @@index([deletedAt])
  @@map("class_schedules")
}

enum ClassSessionStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

model ClassSession {
  id            String             @id @default(cuid())
  classId       String
  /// sessionNumber is a business identifier (like an invoice or order number),
  /// not just a uniqueness key — teachers/staff refer to "Session 8" as a
  /// permanent label. It must never be reused, even after the session is
  /// soft-deleted, so this is a full (not partial) unique constraint, and
  /// generateNextSessionNumber() computes MAX(sessionNumber) across ALL rows
  /// for the Class, including soft-deleted ones. See migration
  /// 20260707000000_class_session_number_never_reused.
  sessionNumber Int
  status        ClassSessionStatus @default(PLANNED)
  date          DateTime
  startTime     DateTime           @db.Time
  endTime       DateTime           @db.Time
  topic         String?
  note          String?
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  class         Class              @relation(fields: [classId], references: [id])
  attendances   Attendance[]

  @@unique([classId, sessionNumber])
  @@index([classId])
  @@index([status])
  @@index([date])
  @@index([deletedAt])
  @@map("class_sessions")
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Enrollment {
  id                   String           @id @default(cuid())
  studentId            String
  classId              String
  /// "One Student cannot have two ACTIVE Enrollments in the same Class" is enforced via
  /// a partial unique index on (studentId, classId) WHERE status = 'ACTIVE' AND "deletedAt"
  /// IS NULL — see migration 20260705000000_add_enrollment. Not expressible as @@unique in
  /// Prisma's schema DSL (partial indexes aren't supported), so the app-level check in
  /// EnrollmentsService is the primary guard and this index is the race-condition backstop.
  status               EnrollmentStatus @default(ACTIVE)
  joinedAt             DateTime
  billingCycleSessions Int
  note                 String?
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  student              Student          @relation(fields: [studentId], references: [id])
  class                Class            @relation(fields: [classId], references: [id])
  attendances          Attendance[]

  @@index([studentId])
  @@index([classId])
  @@index([status])
  @@index([deletedAt])
  @@map("enrollments")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

/// Participation evidence: one row per (Enrollment × ClassSession). Attendance is a
/// consequence-free record — it never stores derivable data (no teacher/classroom/student
/// columns; those are reachable via the enrollment/classSession relations) and no balance
/// counter exists anywhere: remaining lessons are always derived as
/// billingCycleSessions − COUNT(deducting attendance on COMPLETED sessions)
/// (see LessonConsumptionService).
model Attendance {
  id             String           @id @default(cuid())
  /// Uniqueness of (enrollmentId, classSessionId) is enforced via a partial unique index
  /// WHERE "deletedAt" IS NULL — see migration 20260709000000_add_attendance — so a
  /// soft-deleted row's key can be reused while two live rows can never coexist. Not marked
  /// @@unique: Prisma's schema DSL cannot express partial indexes, so all lookups must go
  /// through findFirst/findMany with deletedAt: null, and writes use
  /// findFirst → create/update with a P2002 catch (never prisma.upsert, which requires a
  /// DSL-declared unique).
  enrollmentId   String
  classSessionId String
  status         AttendanceStatus
  note           String?
  markedById     String?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  enrollment     Enrollment       @relation(fields: [enrollmentId], references: [id])
  classSession   ClassSession     @relation(fields: [classSessionId], references: [id])
  markedBy       User?            @relation(fields: [markedById], references: [id], onDelete: Restrict)

  @@index([enrollmentId])
  @@index([classSessionId])
  @@index([status])
  @@index([deletedAt])
  @@map("attendances")
}
