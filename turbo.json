{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": [],
      "env": ["TEST_DATABASE_URL", "ALLOW_ANY_DB", "DATABASE_URL", "DIRECT_URL"]
    },
    "clean": {
      "cache": false
    }
  }
}
